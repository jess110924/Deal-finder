# Required for the Keepa source. Get this from your Keepa account settings.
# Never commit this or paste it into chat — treat it like a password.
KEEPA_API_KEY=

# Optional. Minimum discount percentage for Keepa results. Default: 40.
KEEPA_MIN_DISCOUNT=40

# Optional. Maximum category sales rank for Keepa results — filters out
# obscure items with near-zero real sales, where the "original price" a
# discount is measured against is often a data artifact rather than a real
# price anyone paid. Lower = stricter (more popular items only). Default:
# 300000.
KEEPA_MAX_SALES_RANK=300000
